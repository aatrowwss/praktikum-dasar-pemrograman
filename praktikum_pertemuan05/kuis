def tampilkan_soal(nomor, teks_soal):
    print(f"Soal {nomor}:")
    print(teks_soal)
    print("Pilih jawaban A, B, C atau D")

def periksa_jawaban(jawaban_mahasiswa,
                    kunci_jawaban):
    if jawaban_mahasiswa == kunci_jawaban:
        return True
    else:
        return False

def hitung_skor(jumlah_benar, jumlah_soal):
    skor = (jumlah_benar / jumlah_soal) * 100
    return skor

def main():
    nomor = 1
    tampilkan_soal(nomor, "Apa ibukota Indonesia?")
    pilih_jawaban = input("A. Jakarta\nB. Surabaya\nC. Bandung\nD. Medan\n")
    jawaban = input("Jawaban Anda: ")
    hasil = periksa_jawaban(jawaban, "A")
    if hasil:
        jumlah_benar = 1
    else:
        jumlah_benar = 0
    skor_akhir = hitung_skor(jumlah_benar, 1)
    print(f"Skor akhir: {skor_akhir}")

if __name__ == "__main__":
    main()
